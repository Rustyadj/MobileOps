[Unit]
Description=Private MobileOps to Hermes WebSocket relay
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
ExecStart=/bin/sh -c 'gateway=$(/usr/bin/docker network inspect bridge --format "{{(index .IPAM.Config 0).Gateway}}"); test -n "$gateway"; exec /usr/bin/socat TCP-LISTEN:4863,bind="$gateway",fork,reuseaddr TCP:127.0.0.1:4864'
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
