MOBILEOPS_PUBLIC_URL=https://icfops.srv1427612.hstgr.cloud
MOBILEOPS_HOST=icfops.srv1427612.hstgr.cloud
ADMIN_EMAIL=admin@concreteform.com
ADMIN_PASSWORD=replace-with-a-long-random-password
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32
JWT_REFRESH_SECRET_KEY=replace-with-another-openssl-rand-hex-32
MCP_CONFIRMATION_SECRET=replace-with-a-third-openssl-rand-hex-32

# Dedicated Nathan2 Hermes dashboard. Use the same 64-character random value
# as Nathan2's HERMES_DASHBOARD_BASIC_AUTH_PASSWORD. The backend exchanges the
# password session for a short-lived, single-use WebSocket ticket.
HERMES_NATHAN_GATEWAY_TOKEN=replace-with-openssl-rand-hex-32
HERMES_NATHAN_GATEWAY_URL=ws://127.0.0.1:4864/api/ws
HERMES_NATHAN_CONNECT_HOST=host.docker.internal
HERMES_NATHAN_CONNECT_PORT=4863
HERMES_NATHAN_GATEWAY_BASIC_AUTH=true
HERMES_NATHAN_GATEWAY_USERNAME=mobileops
HERMES_NATHAN_PROFILE=nathan

# Configure one or more comma-separated values to allow self-service registration.
# Invite codes are entered in the account-creation form and should be rotated
# whenever access should be revoked for people who have not registered yet.
SIGNUP_ALLOWED_DOMAINS=
SIGNUP_INVITE_CODES=

# Additive Nathan PSTN voice module. Leave blank until the operator has a
# consented test destination and is ready to place real calls.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=
OPENAI_API_KEY=
VOICE_PUBLIC_BASE_URL=https://icfops.srv1427612.hstgr.cloud
VOICE_REALTIME_MODEL=gpt-realtime-2.1-mini
VOICE_REALTIME_FULL_MODEL=gpt-realtime-2.1
VOICE_REALTIME_VOICE=marin
VOICE_TRANSCRIPTION_MODEL=gpt-live-transcribe
