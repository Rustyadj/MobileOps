{
  "expo": {
    "name": "Concrete Form",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "concreteform",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Upload your company logo for delivery tickets",
        "NSCameraUsageDescription": "Photograph equipment damage during service",
        "NSDocumentsFolderUsageDescription": "Save delivery ticket PDFs",
        "NSLocationWhenInUseUsageDescription": "Pin rental sites on the map from your current location"
      },
      "bundleIdentifier": "com.concreteform.mobileops"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1E3A8A"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "package": "com.concreteform.mobileops"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Upload your company logo for delivery tickets"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pin rental sites on the map from your current location"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
